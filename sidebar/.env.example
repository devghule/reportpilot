# Local dev only. In production the sidebar is built into backend/public/sidebar
# and served by the backend at the same origin, so this is left unset and the
# api client falls back to a relative URL (see src/services/api.service.ts).
#
# For local dev (`npm run dev`, Vite on :5173), point this at your local backend:
VITE_BACKEND_URL=http://localhost:3000
