generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String             @id @default(uuid())
  email     String             @unique
  name      String?
  googleId  String?            @unique
  avatarUrl String?
  plan      String             @default("free")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  accounts  ConnectedAccount[]
  templates Template[]
  schedules Schedule[]
  aiReports AiReport[]
}

model ConnectedAccount {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  metaBmId        String
  metaBmName      String
  metaAccountId   String
  metaAccountName String
  currency        String

  accessToken     String
  tokenExpiresAt  DateTime
  googleRefToken  String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  schedules       Schedule[]

  @@unique([userId, metaAccountId])
}

model Template {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  reportLevel     String
  dateGranularity String
  dateRange       String

  metrics         String[]
  dimensions      String[]
  columnOrder     String[]

  sortBy          String?
  sortDirection   String?

  filters         Json?

  isPrebuilt      Boolean    @default(false)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  schedules       Schedule[]
}

model Schedule {
  id            String           @id @default(uuid())

  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId    String
  template      Template         @relation(fields: [templateId], references: [id])

  accountId     String
  account       ConnectedAccount @relation(fields: [accountId], references: [id])

  frequency     String
  refreshTime   String
  timezone      String

  status        String           @default("active")

  sheetId       String
  sheetTabName  String

  lastRunAt     DateTime?
  lastRunStatus String?
  lastError     String?

  nextRunAt     DateTime?

  retryCount    Int              @default(0)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model AiReport {
  id            String   @id @default(uuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId     String
  accountName   String

  reportData    Json

  promptUsed    String
  insightOutput String

  feedback      String?

  createdAt     DateTime @default(now())
}