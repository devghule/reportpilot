# Database
# Supabase → Settings → Database → Connection string → URI (connection pooling URL)
# This is the only DB URL actually read at runtime (backend/src/prisma/prisma.service.ts).
DATABASE_URL=
# Optional. Not read by app code today; present only because `prisma migrate`
# scaffolding expects it. Safe to leave blank, or set it to the same value as
# DATABASE_URL (Supabase → Settings → Database → "Session" pooler URI, port 5432)
# if you ever run `prisma migrate dev` against a pooled connection.
DIRECT_URL=

# Supabase
# Supabase → Settings → API → Project URL
SUPABASE_URL=
# Supabase → Settings → API → anon public key
SUPABASE_ANON_KEY=
# Supabase → Settings → API → service_role secret key
SUPABASE_SERVICE_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=
# https://your-render-url.render.com/meta/callback
META_REDIRECT_URI=

# Google
# Google Cloud Console → OAuth 2.0 → Web client ID
GOOGLE_CLIENT_ID=
# Google Cloud Console → OAuth 2.0 → Web client secret
GOOGLE_CLIENT_SECRET=
# https://your-render-url.render.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# OpenAI
# platform.openai.com → API keys
OPENAI_API_KEY=

# Security
# Random 64-char string — generate once, never change
JWT_SECRET=
# Random 32-char string — used for AES-256 token encryption
ENCRYPTION_SECRET=

# App
# https://your-render-url.render.com
BACKEND_URL=
# development | production
NODE_ENV=
PORT=3000
