# Database
# Supabase → Settings → Database → Connection string → "Transaction pooler" URI (port 6543)
# Used at runtime by the running app (backend/src/prisma/prisma.service.ts).
# Not used by `prisma migrate` / `prisma db pull` — the pooler doesn't support
# the advisory locks/DDL those need, which is why they read DIRECT_URL instead
# (see prisma.config.ts).
DATABASE_URL=
# Supabase → Settings → Database → Connection string → "Direct connection" URI (port 5432)
# Used only by the Prisma CLI (migrate deploy/dev, db pull, studio) via
# prisma.config.ts. Required — without it the CLI falls back to DATABASE_URL
# and migrate deploy will hang against the pooler.
DIRECT_URL=

# Supabase
# Supabase → Settings → API → Project URL
SUPABASE_URL=
# Supabase → Settings → API → anon public key
SUPABASE_ANON_KEY=
# Supabase → Settings → API → service_role secret key
SUPABASE_SERVICE_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=
# https://your-render-url.render.com/meta/callback
META_REDIRECT_URI=

# Google
# Google Cloud Console → OAuth 2.0 → Web client ID
GOOGLE_CLIENT_ID=
# Google Cloud Console → OAuth 2.0 → Web client secret
GOOGLE_CLIENT_SECRET=
# https://your-render-url.render.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# OpenAI
# platform.openai.com → API keys
OPENAI_API_KEY=

# Security
# Random 64-char string — generate once, never change
JWT_SECRET=
# Random 32-char string — used for AES-256 token encryption
ENCRYPTION_SECRET=

# App
# https://your-render-url.render.com
BACKEND_URL=
# development | production
NODE_ENV=
PORT=3000
